{
  "manifest_version": 3,
  "name": "Amplify",
  "description": "Volume boost up to 600% that works in fullscreen. EQ, night mode, per-site profiles.",
  "version": "2.1.0",
  "permissions": ["activeTab", "storage", "scripting", "contextMenus", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "amplify@rednodestudio.in",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "volume-up": {
      "suggested_key": { "default": "Alt+Shift+Up" },
      "description": "Volume up (+25%)"
    },
    "volume-down": {
      "suggested_key": { "default": "Alt+Shift+Down" },
      "description": "Volume down (-25%)"
    },
    "toggle-mute": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Mute / unmute tab"
    }
  }
}
